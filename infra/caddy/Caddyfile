# Single origin for the whole app. Plain HTTP: the Cloudflare Tunnel terminates TLS and is the
# only client of this port (published on 127.0.0.1 only).
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	# SignalR hubs (WebSocket upgrades are proxied as-is).
	handle /hubs/* {
		reverse_proxy backend:8080
	}

	# Liveness only; readiness lists internal dependencies and stays private.
	handle /health/live {
		reverse_proxy backend:8080
	}

	# Presigned Garage URLs: the prefix is stripped so Garage sees /{bucket}/{key} (.ia/files.md).
	handle_path /storage/* {
		reverse_proxy garage:3900
	}

	handle {
		reverse_proxy frontend:8080
	}
}
