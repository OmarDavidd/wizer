# Production settings. Copy to .env.prod on the server (never commit it) and fill every value:
#   cp infra/prod.env.example .env.prod
# Generate secrets with the commands shown; never reuse the development defaults.

# Host port Caddy listens on (127.0.0.1 only). Point the Cloudflare Tunnel hostname here.
WIZER_HTTP_PORT=8088

# --- PostgreSQL ---
POSTGRES_DB=wizer
POSTGRES_USER=wizer
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Garage (S3 storage) ---
# openssl rand -hex 32
GARAGE_RPC_SECRET=
# echo GK$(openssl rand -hex 12)
GARAGE_ACCESS_KEY=
# openssl rand -hex 32
GARAGE_SECRET_KEY=
GARAGE_BUCKET=wizer

# --- Authentication ---
# HS256 key for the access JWT (at least 32 bytes): openssl rand -base64 48
JWT_SIGNING_KEY=

# --- Google sign-in ---
# OAuth client id (Google Cloud Console → Credentials), same value as the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- Email (Resend) ---
# Needs a verified sending domain in Resend; until then codes are not delivered (failures are only logged).
RESEND_API_KEY=
EMAIL_FROM=Wizer <no-reply@wizer.omard.space>

# --- First administrator ---
# Created at startup while no administrator exists (in the existing institution); afterwards it does nothing,
# so the password can be removed. At least 10 characters with a letter and a number.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
