root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

# Generated by `dotnet ef migrations add`, which writes a BOM. Never edit by hand.
[**/Migrations/*.cs]
charset = utf-8-bom
generated_code = true

[*.{csproj,props,targets,slnx}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
