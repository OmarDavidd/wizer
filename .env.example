# Copy to .env: cp .env.example .env (or run: make setup)
# Local development only. Placeholder values: replace them in your .env.
# Never reuse them in production.

# --- PostgreSQL ---
POSTGRES_DB=wizer
POSTGRES_USER=wizer
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Garage (S3 storage) ---
# Defaults in docker-compose.dev.yml work as-is. Only override them with valid values:
#   GARAGE_RPC_SECRET / GARAGE_SECRET_KEY: 64 hex chars (openssl rand -hex 32)
#   GARAGE_ACCESS_KEY: "GK" + 24 hex chars (echo GK$(openssl rand -hex 12))
# GARAGE_RPC_SECRET=
# GARAGE_ACCESS_KEY=
# GARAGE_SECRET_KEY=
GARAGE_BUCKET=wizer
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903

# --- Seed (development data) ---
# Password of every seeded account (admin@wizer.local, docente1@wizer.local, alumno01@wizer.local…)
# Default in the Makefile (WizerDev2026). Uncomment only to use another one.
# SEED_PASSWORD=

# --- ClamAV ---
CLAMAV_PORT=3310

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
